# Copy this file to .env and adjust values when needed.
# The included defaults work with the model bundled in this repository.

FASHION_MODEL_PATH=models/deepfashion2_yolov8s-seg.pt
FASHION_CONFIDENCE=0.35
FASHION_IMAGE_SIZE=640

# Seeed reCamera preview WebSocket. The USB-network default is 192.168.42.1.
RECAMERA_HOST=192.168.42.1
RECAMERA_PORT=8090
RECAMERA_TIMEOUT=5
RECAMERA_FPS=15
